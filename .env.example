# InsightFlow AI — Environment Configuration Template
# Copy to .env and adjust values for your environment. Never commit real secrets.

# Core Application Settings
APP_NAME=InsightFlow AI
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Frontend Configuration
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration (PostgreSQL Async)
DATABASE_URL=postgresql+asyncpg://insightflow:insightflow@localhost:5432/insightflow
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=insightflow-insecure-dev-secret-key-replace-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Abstraction
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=YOUR_GEMINI_API_KEY
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.1

# Object Storage / Data Runtime
STORAGE_BACKEND=local
DATA_DIR=./data/runtime
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=insightflow
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Logging & Observability
LOG_LEVEL=INFO
LOG_FORMAT=text
