# ==============================================================================
# InsightFlow AI — Environment Configuration Reference
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & Cryptography (Generate strong secrets in production)
# Example: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production / SQLite for local development)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/insightflow_db
# Local SQLite fallback: sqlite+aiosqlite:///./insightflow.db

# Storage Directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
EXPORTS_DIR=./data/exports

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_AI_MODEL=gemini-2.0-flash
FALLBACK_AI_MODEL=gemini-1.5-pro

# Observability & Telemetry
ENABLE_METRICS=true
METRICS_PORT=9090
LOG_LEVEL=INFO
TRACING_ENABLED=true

# Multi-Tenant Cache & Rate Limiting
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=100
